NODE_ENV=development
PORT=5000
WEB_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

MONGO_URI=mongodb://127.0.0.1:27017/backend_starter_hb
REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_REFRESH_TTL_SECONDS=604800

COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

EMAIL_QUEUE_ENABLED=true
EMAIL_FROM=Backend Starter <no-reply@example.com>
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=replace-with-smtp-user
EMAIL_PASSWORD=replace-with-smtp-password

RATE_LIMIT_GLOBAL_MAX=200
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_PASSWORD_MAX=3
